# Copy to .env (git-ignored) and fill in. pipeline-run.sh creates .env from this file when it is
# missing, and generates DB_PASSWORD and ADMIN_PASSWORD if they are empty.

# Optional: only used by pipeline-run.sh when TUNNEL_TOKEN is not set globally on the server.
TUNNEL_TOKEN=

# Postgres. DB_PASSWORD is required. These only take effect when the pgdata volume is first
# created: changing them later needs ALTER USER inside Postgres.
DB_USER=suite
DB_PASSWORD=
DB_NAME=suite

# The first administrator, created once on an empty database. ADMIN_PASSWORD needs at least 12
# characters. Change it in the app afterwards: later edits here are not applied.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# The company name on first start. Edit it later in Settings > Company.
COMPANY_NAME=My Company

# Loads a sample company on first start. Set to false BEFORE the first start for real use: demo
# data cannot be removed automatically. Demo employees cannot sign in.
SEED_DEMO_DATA=true

# Keep true behind the HTTPS tunnel. Only for plain http on another machine, set to false.
COOKIE_SECURE=true

# Host port for the web app, bound to 127.0.0.1 only.
WEB_PORT=8096

# The site's public address, used for unsubscribe links in mailings, e.g. https://example.com
PUBLIC_URL=

# Outgoing email for Email Marketing. Without these the Send button explains what is missing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
